# ===========================================
# Mizoke - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# -------------------------------------------
# Shopify (Required)
# -------------------------------------------

# Your Shopify store domain (e.g., my-store.myshopify.com)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Storefront API access token (public, used for product queries, cart, etc.)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Admin API access token (legacy static token — optional if using OAuth below)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Admin API OAuth client credentials (from Shopify Dev Dashboard app)
# These are used to auto-fetch short-lived tokens. Preferred over static token.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# Webhook HMAC secret for verifying Shopify webhook signatures
SHOPIFY_WEBHOOK_SECRET=

# -------------------------------------------
# Site (Optional)
# -------------------------------------------

# Your production site URL (defaults to https://mizoke.com)
NEXT_PUBLIC_SITE_URL=https://mizoke.com

# -------------------------------------------
# Admin (Optional)
# -------------------------------------------

# Secret for authenticating admin API routes (e.g., gacha code generation)
ADMIN_SECRET=

# Secret for gacha metaobject setup endpoint (defaults to dev-setup-secret)
GACHA_SETUP_SECRET=

# -------------------------------------------
# Sentry (Optional - Error Monitoring)
# -------------------------------------------

# Get your DSN from https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token for source map uploads (get from sentry.io/settings/auth-tokens)
SENTRY_AUTH_TOKEN=

# Sentry organization and project slugs
SENTRY_ORG=
SENTRY_PROJECT=

# -------------------------------------------
# Upstash Redis (Optional - Rate Limiting)
# -------------------------------------------

# Get these from https://console.upstash.com → Create Redis Database
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -------------------------------------------
# Resend (Optional - Contact Form Emails)
# -------------------------------------------

# Get your API key from https://resend.com → API Keys
# Without this, contact form submissions are logged but not emailed.
RESEND_API_KEY=
